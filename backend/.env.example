PORT=4000
# Gemini powers photo recognition and recipe/substitution text (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter: used for text and photo recognition when no Gemini key is set
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# Must accept images; used for photo recognition when GEMINI_API_KEY is empty.
# Comma-separated, tried in order (free models are often rate-limited).
# Paid alternative, Gemini at a fraction of a cent per photo: google/gemini-3.8-flash
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# Firebase service account JSON (Firestore storage + Auth token verification).
# Defaults to scripts/serviceAccountKey.json; without it data is kept in memory.
FIREBASE_SERVICE_ACCOUNT=
# Development conveniences (default: on unless NODE_ENV=production)
ALLOW_DEVICE_AUTH=true
ALLOW_MOCK_VISION=true
